---
import { Icon } from "astro-icon/components";
import { menus } from "../constant";
import { cn } from "../lib/cn";

const path = Astro.url.pathname;
---

<nav class="sticky top-0 z-20 border-b border-line/75 bg-paper/90 backdrop-blur-[16px]" aria-label="Main navigation">
	<div class="mx-auto flex min-h-16 w-[calc(100%-32px)] max-w-[1180px] items-center justify-between gap-6 min-[721px]:min-h-[72px] min-[721px]:w-[calc(100%-48px)]">
		<a href="/" class="font-display text-[26px] font-bold leading-none tracking-[-.03em]" aria-label="Denny Setyawan Huda, home">D.</a>
		<div class="flex items-center gap-3 min-[721px]:gap-5">
			<div class="flex items-center gap-[14px] min-[721px]:gap-[clamp(16px,3vw,36px)]">
				{menus.map((menu) => <a href={menu.href} class={cn("text-xs text-muted transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent min-[721px]:text-[13px]", path === menu.href && "underline decoration-accent underline-offset-[7px]")} aria-current={path === menu.href ? "page" : undefined}>{menu.label}</a>)}
			</div>
			<a class="inline-grid place-items-center p-2 text-muted transition-colors hover:text-ink" href="https://github.com/dennyshuda" target="_blank" rel="noreferrer" aria-label="GitHub">
				<Icon name="brand-github" size={19} />
			</a>
			<button id="theme-toggle" type="button" class="inline-grid cursor-pointer place-items-center border-0 bg-transparent p-2 text-muted transition-colors hover:text-ink" aria-label="Use dark theme">
				<span class="dark:hidden"><Icon name="sun" size={19} /></span>
				<span class="hidden dark:inline-flex"><Icon name="moon" size={19} /></span>
			</button>
		</div>
	</div>
</nav>

<script>
	const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
	toggle?.addEventListener("click", () => {
		const dark = document.documentElement.classList.toggle("dark");
		localStorage.setItem("theme", dark ? "dark" : "light");
		toggle.setAttribute("aria-label", dark ? "Use light theme" : "Use dark theme");
	});
</script>
