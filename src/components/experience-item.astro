---
interface Props {
	exp: {
		period: string;
		type: string;
		role: string;
		company: string;
		description: string;
		skills: string[];
	};
}
const { exp } = Astro.props;
---

<article class="grid grid-cols-1 gap-[9px] border-b border-line py-6 min-[721px]:grid-cols-[150px_1fr] min-[721px]:gap-6">
	<div>
		<p class="m-0 text-[11px] font-semibold uppercase tracking-[.1em] text-accent">{exp.period}</p>
		<span class="text-[11px] font-semibold uppercase tracking-[.16em] text-muted">{exp.type}</span>
	</div>
	<div>
		<h3 class="mb-1.5 mt-0 font-display text-[30px] font-semibold uppercase leading-none">{exp.role}</h3>
		<p class="mb-[10px] mt-0 text-[13px] text-muted">{exp.company}</p>
		<p class="m-0 text-[13px] leading-[1.7] text-muted">{exp.description}</p>
		<div class="mt-3 flex flex-wrap gap-[7px]">
			{exp.skills.map((skill) => <span class="text-[10px] uppercase tracking-[.06em] text-muted">{skill}</span>)}
		</div>
	</div>
</article>
