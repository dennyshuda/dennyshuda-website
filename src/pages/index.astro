---
import Layout from "../layouts/Layout.astro";
import { experiences, projects, services, stacks } from "../constant";
import ExperienceItem from "../components/experience-item.astro";
import { cn } from "../lib/cn";

const shell = "mx-auto w-[calc(100%-32px)] max-w-[1180px] min-[721px]:w-[calc(100%-48px)]";
const eyebrow = "text-[11px] font-semibold uppercase tracking-[.16em] text-muted";
const sectionTitle =
	"m-0 font-display text-[clamp(38px,6vw,68px)] font-semibold uppercase leading-[.95] tracking-[-.025em]";
const projectRow =
	"group relative grid grid-cols-[40px_minmax(0,1fr)_auto] items-center gap-3 border-b border-line py-[21px] transition-transform duration-200 before:absolute before:inset-x-0 before:top-0 before:h-px before:origin-left before:scale-x-0 before:bg-accent before:transition-transform before:duration-200 hover:translate-x-1 hover:before:scale-x-100 focus-visible:translate-x-1 focus-visible:before:scale-x-100 motion-reduce:transition-none min-[721px]:grid-cols-[70px_minmax(0,1fr)_minmax(190px,.7fr)_auto] min-[721px]:gap-6 min-[721px]:py-[27px] min-[721px]:hover:translate-x-2 min-[721px]:focus-visible:translate-x-2";
const button =
	"inline-flex items-center gap-3 border px-[17px] py-[13px] text-[13px] font-semibold transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none";
---

<Layout title="Denny Setyawan Huda — Software Developer">
	<main class="min-h-[70vh]">
		<section
			class={cn(
				shell,
				"grid items-end gap-8 py-16 min-[721px]:grid-cols-[1.2fr_.8fr] min-[721px]:gap-[clamp(32px,7vw,92px)] min-[721px]:py-[clamp(64px,9vw,120px)]",
			)}
		>
			<div>
				<p class={eyebrow}>Software developer · Jakarta, Indonesia</p>
				<h1
					class="m-0 font-display text-[clamp(62px,11vw,132px)] font-semibold uppercase leading-[.86] tracking-[-.035em]"
				>
					Denny<br /><span class="text-accent">Setyawan</span><br />Huda
				</h1>
			</div>
			<div class="max-w-107.5 text-[clamp(16px,1.6vw,19px)] leading-[1.75] text-muted">
				<p class="mb-6.5 mt-0">
					I’m a software developer working across the JavaScript and TypeScript ecosystem. I use AI
					assistants like OpenCode, Claude, and Codex as part of my development workflow.
				</p>
				<div class="flex flex-wrap items-center gap-3">
					<a
						class={cn(button, "border-accent bg-accent text-white hover:brightness-90")}
						href="/projects">Explore selected work <span aria-hidden="true">↗</span></a
					>
					<a class={cn(button, "border-ink text-ink hover:bg-ink hover:text-paper")} href="/contact"
						>Get in touch <span aria-hidden="true">→</span></a
					>
					<a
						class="text-[13px] text-muted underline-offset-4 hover:text-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
						href="/cv.pdf"
						download>Download CV ↓</a
					>
				</div>
				<p class={cn(eyebrow, "mt-5.5")}>Remote friendly</p>
			</div>
		</section>

		<section class={shell} aria-labelledby="work-heading">
			<div
				class="flex flex-col items-start justify-between gap-4 border-b border-line pb-4.5 min-[721px]:flex-row min-[721px]:items-end"
			>
				<div>
					<p class={eyebrow}>Selected work</p><h2 class={sectionTitle} id="work-heading">
						Built with intent.
					</h2>
				</div>
				<a
					class="text-[13px] text-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
					href="/projects">View all projects ↗</a
				>
			</div>
			<div>
				{
					projects.slice(0, 3).map((project, index) => (
						<a class={projectRow} href={`/projects#project-${index + 1}`}>
							<span class="font-display text-xl font-semibold text-accent">0{index + 1}</span>
							<h3 class="m-0 font-display text-[clamp(27px,3.4vw,42px)] font-semibold uppercase leading-[.98] tracking-[-.015em]">
								{project.title}
							</h3>
							<p class="col-start-2 row-start-2 m-0 max-w-107.5 text-[13px] leading-[1.65] text-muted min-[721px]:col-auto min-[721px]:row-auto">
								{project.description}
							</p>
							<span class="col-start-3 row-start-1 text-[22px] text-accent transition-transform duration-200 group-hover:translate-x-0.75 group-hover:-translate-y-0.75 motion-reduce:transition-none">
								↗
							</span>
						</a>
					))
				}
			</div>
		</section>

		<section
			class={cn(
				shell,
				"grid gap-8 py-[clamp(64px,9vw,120px)] min-[721px]:grid-cols-[.7fr_1.3fr] min-[721px]:gap-[clamp(32px,8vw,110px)]",
			)}
		>
			<div>
				<p class={eyebrow}>How I work</p><h2 class={sectionTitle}>
					A thoughtful<br />digital craft.
				</h2>
			</div>
			<div>
				<p class="m-0 max-w-130 text-base leading-[1.8] text-muted">
					I build digital experiences with care for the details that make them useful, clear, and
					resilient.
				</p>
				<div class="mt-8 grid gap-6 min-[721px]:grid-cols-3 min-[721px]:gap-6">
					{
						services.map((service) => (
							<article class="border-t-2 border-ink pt-3.75">
								<p class={eyebrow}>{service.status}</p>
								<h3 class="mb-2.5 mt-0 font-display text-[27px] font-semibold uppercase leading-none">
									{service.title}
								</h3>
								<p class="m-0 text-[13px] leading-[1.7] text-muted">{service.desc}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class={cn(shell, "pb-[clamp(64px,9vw,120px)]")}>
			<div class="border-b border-line pb-4.5">
				<p class={eyebrow}>Experience</p><h2 class={sectionTitle}>The journey so far.</h2>
			</div>
			<div class="border-t border-line">
				{experiences.map((exp) => <ExperienceItem exp={exp} />)}
			</div>
		</section>

		<section class={cn(shell, "pb-22.5")}>
			<div class="border-b border-line pb-4.5">
				<p class={eyebrow}>Tools of the trade</p><h2 class={sectionTitle}>Technology I use.</h2>
			</div>
			<div class="flex flex-wrap gap-4 pt-6">
				{
					stacks.map((tech) => (
						<span class="text-[11px] uppercase tracking-[.06em] text-muted">{tech}</span>
					))
				}
			</div>
		</section>
	</main>
</Layout>
