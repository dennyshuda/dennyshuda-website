---
import Layout from "../layouts/Layout.astro";
import { contactMethods } from "../constant";
import { cn } from "../lib/cn";

const shell = "mx-auto w-[calc(100%-32px)] max-w-[1180px] min-[721px]:w-[calc(100%-48px)]";
const eyebrow = "text-[11px] font-semibold uppercase tracking-[.16em] text-muted";
const displayTitle =
	"m-0 font-display text-[clamp(62px,11vw,132px)] font-semibold uppercase leading-[.86] tracking-[-.035em]";
---

<Layout title="Contact — Denny Setyawan Huda">
	<main class={cn(shell, "min-h-[70vh] py-16 min-[721px]:py-[clamp(64px,9vw,120px)]")}>
		<div class="grid gap-12 min-[721px]:grid-cols-2 min-[721px]:gap-12">
			<section>
				<p class={eyebrow}>Contact</p>
				<h1 class={displayTitle}>
					Let's build<br /><span class="text-accent">something</span><br />great.
				</h1>
				<p class="mt-7 max-w-107.5 text-[clamp(16px,1.6vw,19px)] leading-[1.75] text-muted">
					I'm always open to discussing new projects, creative ideas, or opportunities to be part of
					your vision. Feel free to reach out.
				</p>
			</section>
			<section aria-label="Contact methods">
				<p class={eyebrow}>Reach me directly</p>
				<div class="border-t border-line">
					{
						contactMethods.map((method) => (
							<a
								class="group flex items-center justify-between gap-5 border-b border-line py-5.25"
								href={method.href}
								target="_blank"
								rel="noreferrer"
							>
								<div>
									<>
										<strong class="font-display text-[27px] font-semibold uppercase leading-none">
											{method.name}
										</strong>
										<br />
										<span class="text-[13px] text-muted">{method.value}</span>
									</>
								</div>
								<span
									class="text-[22px] text-accent transition-transform duration-200 group-hover:translate-x-0.75 group-hover:-translate-y-0.75 motion-reduce:transition-none"
									aria-hidden="true"
								>
									↗
								</span>
							</a>
						))
					}
				</div>
				<p class="mt-6 max-w-130 text-base leading-[1.8] text-muted">
					I usually respond within 24–48 hours. Looking forward to hearing from you!
				</p>
			</section>
		</div>
	</main>
</Layout>
