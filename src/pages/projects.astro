---
import Layout from "../layouts/Layout.astro";
import { projects } from "../constant";
import { cn } from "../lib/cn";

const shell = "mx-auto w-[calc(100%-32px)] max-w-[1180px] min-[721px]:w-[calc(100%-48px)]";
const eyebrow = "text-[11px] font-semibold uppercase tracking-[.16em] text-muted";
const sectionTitle =
	"m-0 font-display text-[clamp(38px,6vw,68px)] font-semibold uppercase leading-[.95] tracking-[-.025em]";
const row =
	"relative grid grid-cols-[40px_minmax(0,1fr)_auto] items-center gap-3 border-b border-line py-[21px] before:absolute before:inset-x-0 before:top-0 before:h-px before:origin-left before:scale-x-0 before:bg-accent before:transition-transform before:duration-200 hover:before:scale-x-100 min-[721px]:grid-cols-[70px_minmax(0,1fr)_minmax(190px,.7fr)_auto] min-[721px]:gap-6 min-[721px]:py-[27px]";
---

<Layout title="Projects — Denny Setyawan Huda">
	<main class={cn(shell, "min-h-[70vh] py-16 min-[721px]:py-[clamp(64px,9vw,120px)]")}>
		<header class="mb-19 grid items-end gap-8 min-[721px]:grid-cols-[1.2fr_.8fr]">
			<div>
				<p class={eyebrow}>Selected work</p><h1
					class="m-0 font-display text-[clamp(62px,11vw,132px)] font-semibold uppercase leading-[.86] tracking-[-.035em]"
				>
					Selected<br /><span class="text-accent">works.</span>
				</h1>
			</div>
			<p class="m-0 max-w-107.5 text-[clamp(16px,1.6vw,19px)] leading-[1.75] text-muted">
				A collection of digital products, experiments, and open-source contributions crafted with
				precision and passion.
			</p>
		</header>
		<div class="flex items-end justify-between gap-6 border-b border-line pb-4.5">
			<h2 class={sectionTitle}>Project index</h2><p class="m-0 text-[13px] text-muted">
				{projects.length} projects
			</p>
		</div>
		<div>
			{
				projects.map((project, index) => (
					<article class={row} id={`project-${index + 1}`}>
						<span class="font-display text-xl font-semibold text-accent">
							{String(index + 1).padStart(2, "0")}
						</span>
						<h3 class="m-0 font-display text-[clamp(27px,3.4vw,42px)] font-semibold uppercase leading-[.98] tracking-[-.015em]">
							{project.title}
						</h3>
						<div class="col-start-2 row-start-2 min-[721px]:col-auto min-[721px]:row-auto">
							<p class="m-0 max-w-107.5 text-[13px] leading-[1.65] text-muted">
								{project.description}
							</p>
							<div class="mt-3 flex flex-wrap gap-1.75">
								{project.tech.map((tech) => (
									<span class="text-[10px] uppercase tracking-[.06em] text-muted">{tech}</span>
								))}
							</div>
						</div>
						<span class="col-start-3 row-start-1 text-[11px] leading-[1.8] text-muted min-[721px]:col-auto min-[721px]:row-auto">
							Case
							<br />
							{String(index + 1).padStart(2, "0")}
						</span>
					</article>
				))
			}
		</div>
	</main>
</Layout>
