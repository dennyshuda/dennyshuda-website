---
import Layout from "../layouts/Layout.astro";
const eyebrow = "text-[11px] font-semibold uppercase tracking-[.16em] text-muted";
---

<Layout title="Page not found — Denny Setyawan Huda">
	<main
		class="mx-auto min-h-[70vh] w-[calc(100%-32px)] max-w-295 py-16 min-[721px]:w-[calc(100%-48px)] min-[721px]:py-[clamp(64px,9vw,120px)]"
	>
		<p class={eyebrow}>Error · 404</p>
		<h1
			class="m-0 font-display text-[clamp(62px,11vw,132px)] font-semibold uppercase leading-[.86] tracking-[-.035em]"
		>
			This page<br /><span class="text-accent">is missing.</span>
		</h1>
		<p class="my-7 max-w-107.5 text-[clamp(16px,1.6vw,19px)] leading-[1.75] text-muted">
			The page you are looking for could not be found.
		</p>
		<a
			href="/"
			class="inline-flex items-center gap-3 border border-accent bg-accent px-4.25 py-3.25 text-[13px] font-semibold text-white transition-colors hover:brightness-90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
			>Back to home <span aria-hidden="true">↗</span></a
		>
	</main>
</Layout>
