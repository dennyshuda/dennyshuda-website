---
import Layout from "../layouts/Layout.astro";
import { chapters } from "../constant";
import { cn } from "../lib/cn";

const values = [
	{
		title: "Clean code",
		description: "Writing code that is not only functional but also readable and maintainable.",
	},
	{
		title: "User centric",
		description: "Putting the user's experience at the heart of every design decision.",
	},
	{
		title: "Continuous learning",
		description: "Always exploring new technologies to stay at the forefront of digital trends.",
	},
];
const shell = "mx-auto w-[calc(100%-32px)] max-w-[1180px] min-[721px]:w-[calc(100%-48px)]";
const eyebrow = "text-[11px] font-semibold uppercase tracking-[.16em] text-muted";
const sectionTitle =
	"m-0 font-display text-[clamp(38px,6vw,68px)] font-semibold uppercase leading-[.95] tracking-[-.025em]";
const displayTitle =
	"m-0 font-display text-[clamp(62px,11vw,132px)] font-semibold uppercase leading-[.86] tracking-[-.035em]";
const timelineItem =
	"grid grid-cols-1 gap-[9px] border-b border-line py-6 min-[721px]:grid-cols-[150px_1fr] min-[721px]:gap-6";
---

<Layout title="About — Denny Setyawan Huda">
	<main class={cn(shell, "min-h-[70vh] py-16 min-[721px]:py-[clamp(64px,9vw,120px)]")}>
		<section
			class="mb-[clamp(64px,9vw,110px)] grid items-start gap-8 min-[721px]:grid-cols-[1.2fr_.8fr] min-[721px]:gap-[clamp(32px,7vw,92px)]"
		>
			<div>
				<p class={eyebrow}>About Denny</p><h1 class={displayTitle}>
					A little<br />about <span class="text-accent">me.</span>
				</h1>
			</div>
			<div class="max-w-180 text-[17px] leading-[1.85] text-muted">
				<p class="mb-5 mt-0">
					I'm <strong class="font-semibold text-ink">Denny Setyawan Huda</strong>, a Software Developer
					based in Indonesia. I build software across the JavaScript and TypeScript ecosystem.
				</p>
				<p class="m-0">
					My journey in technology started with a curiosity about how things work on the internet.
					Today, my toolkit includes <span class="text-accent">JavaScript, TypeScript, React, Next.js,
						Astro, and Node.js</span>. I also work with AI assistants like OpenCode, Claude, and Codex
					as part of my development workflow.
				</p>
			</div>
		</section>

		<section class="border-t border-line py-[clamp(64px,9vw,120px)]">
			<div class="border-b border-line pb-4.5">
				<p class={eyebrow}>A few principles</p><h2 class={sectionTitle}>My philosophy.</h2>
			</div>
			<div class="mt-8 grid gap-6 min-[721px]:grid-cols-3">
				{
					values.map((value) => (
						<article class="border-t-2 border-ink pt-3.75">
							<>
								<h3 class="mb-2.5 mt-0 font-display text-[27px] font-semibold uppercase leading-none">
									{value.title}
								</h3>
								<p class="m-0 text-[13px] leading-[1.7] text-muted">{value.description}</p>
							</>
						</article>
					))
				}
			</div>
		</section>

		<section class="border-t border-line py-[clamp(64px,9vw,120px)]">
			<div class="border-b border-line pb-4.5">
				<p class={eyebrow}>Learning over time</p><h2 class={sectionTitle}>The journey.</h2>
			</div>
			<div class="border-t border-line">
				{
					chapters.map((chapter) => (
						<article class={timelineItem}>
							<p class="m-0 text-[11px] font-semibold uppercase tracking-widest text-accent">
								{chapter.period}
							</p>
							<div>
								<>
									<h3 class="mb-1.5 mt-0 font-display text-[30px] font-semibold uppercase leading-none">
										{chapter.title}
									</h3>
									<p class="m-0 text-[13px] leading-[1.7] text-muted">{chapter.description}</p>
									<div class="mt-3 flex flex-wrap gap-1.75">
										{chapter.techs.map((tech) => (
											<span class="text-[10px] uppercase tracking-[.06em] text-muted">{tech}</span>
										))}
									</div>
								</>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section
			class="grid gap-8 border-t border-line py-[clamp(64px,9vw,120px)] min-[721px]:grid-cols-[.7fr_1.3fr] min-[721px]:gap-[clamp(32px,8vw,110px)]"
		>
			<div>
				<p class={eyebrow}>Outside of the IDE</p><h2 class={sectionTitle}>Other<br />interests.</h2>
			</div>
			<div class="max-w-180 text-[17px] leading-[1.85] text-muted">
				<p class="mb-5 mt-0">
					When I'm not coding, I love exploring <span class="text-accent">local brands</span> and <span
						class="text-accent">local fragrances</span
					>. I really appreciate the quality and stories behind homegrown products.
				</p>
				<p class="m-0">
					To unwind, I usually spend my time playing <span class="text-accent">Valorant</span> with friends.
					Lately, I've also been curious about the stock market and learning how to invest for the future.
				</p>
			</div>
		</section>
		<section
			class="flex flex-col items-start justify-between gap-6 border-t border-line py-7 min-[721px]:flex-row min-[721px]:items-center"
		>
			<h2 class={sectionTitle}>Let's make something.</h2><a
				class="inline-flex items-center gap-3 border border-accent bg-accent px-4.25 py-3.25 text-[13px] font-semibold text-white transition-colors hover:brightness-90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
				href="/contact">Get in touch ↗</a
			>
		</section>
	</main>
</Layout>
